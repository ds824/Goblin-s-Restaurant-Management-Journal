  m_Script: {fileID: 11500000, guid: dbd6c95bd54013146b26e3bc01170540, type: 3}
  m_Name: Topic_Business_Phase
  m_EditorClassIdentifier: Assembly-CSharp::TutorialData
  topicTitle: "\uC601\uC5C5 \uB2E8\uACC4"
  steps:
  - description: "\uC601\uC5C5 \uC21C\uC11C\n\uC601\uC5C5 \uB2E8\uACC4\uB294 '\uC601\uC5C5
      \uC900\uBE44', '\uC601\uC5C5 \uC911', '\uC601\uC5C5 \uC885\uB8CC'\uB85C \uAD6C\uC131\uB41C\uB2E4."
    contentImage: {fileID: 0}
  - description: "1. \uC601\uC5C5 \uC900\uBE44\n\uB9E4\uC77C 09\uC2DC \uB9C8\uB2E4
      \uC601\uC5C5 \uC900\uBE44\uB97C \uD558\uAC8C \uB429\uB2C8\uB2E4.\n\uC601\uC5C5\uC744
      \uD558\uAE30 \uC804, \uC7AC\uB8CC\uC640 \uBA54\uB274\uB97C \uC900\uBE44\uD558\uB294
      \uC2DC\uAC04\uC785\uB2C8\uB2E4.\n\uC0C1\uC810, \uB808\uC2DC\uD53C, \uBA54\uB274,
      \uC9C1\uC6D0 \uAE30\uB2A5\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC01
      \uAE30\uB2A5\uC758 \uC790\uC138\uD55C \uB0B4\uC6A9\uC740 \uB530\uB85C \uB2E4\uB8E8\uACE0
      \uC788\uC73C\uB2C8 \uD655\uC778\uD574\uC8FC\uC138\uC694!"
    contentImage: {fileID: 0}
  - description: "2. \uC601\uC5C5 \uC911\n\uC2DD\uB2F9\uC744 \uC601\uC5C5\uD558\uB294
      \uB2E8\uACC4\uB85C, \uC190\uB2D8\uB4E4\uC774 \uC2DD\uB2F9\uC744 \uBC29\uBB38\uD569\uB2C8\uB2E4.\n\uC601\uC5C5
      \uC2DC\uAC04\uC740 09:00 ~ 18:00 \uC785\uB2C8\uB2E4.\n\n\uC2DD\uC0AC\uB97C
      \uB9C8\uCE5C \uC190\uB2D8\uC740 \uC74C\uC2DD\uAC12\uACFC \uD301\uC744 \uC9C0\uBD88\uD558\uAC8C
      \uB429\uB2C8\uB2E4.\n\uC774\uB54C, \uC11C\uBE44\uC2A4\uC758 \uD488\uC9C8\uC5D0
      \uB530\uB77C \uB9CC\uC871\uB3C4\uAC00 \uACB0\uC815\uB429\uB2C8\uB2E4."
    contentImage: {fileID: 0}
  - description: "3. \uC601\uC5C5 \uC885\uB8CC\n\uC2DC\uAC04\uC774 18:00\uC774 \uB418\uAC70\uB098
      \uC900\uBE44\uD55C \uBA54\uB274\uAC00 \uC804\uBD80 \uC18C\uC9C4\uB418\uBA74,
      \uC601\uC5C5\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4.\n\uC601\uC5C5\uC774 \uC885\uB8CC\uB418\uBA74,
      \uC77C\uC77C \uC815\uC0B0\uC744 \uC9C4\uD589\uD569\uB2C8\uB2E4.\n\n\uC77C\uC77C
      \uC815\uC0B0\uC5D0\uC11C\uB294 \uB9E4\uCD9C, \uC7AC\uC0B0, \uBC29\uBB38\uAC1D
      \uC218\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    contentImage: {fileID: 0}
